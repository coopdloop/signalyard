FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/schema-registry ./cmd/schema-registry

FROM alpine:3.20
RUN adduser -D -u 10001 app
COPY --from=build /bin/schema-registry /bin/schema-registry
USER app
EXPOSE 8082
ENTRYPOINT ["/bin/schema-registry"]
