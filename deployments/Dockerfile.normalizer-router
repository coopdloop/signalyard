FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/normalizer-router ./cmd/normalizer-router

FROM alpine:3.20
RUN adduser -D -u 10001 app
COPY --from=build /bin/normalizer-router /bin/normalizer-router
USER app
EXPOSE 8081
ENTRYPOINT ["/bin/normalizer-router"]
