FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/webhook-adapter ./cmd/webhook-adapter

FROM alpine:3.24
RUN adduser -D -u 10001 app
COPY --from=build /bin/webhook-adapter /bin/webhook-adapter
USER app
EXPOSE 8084
ENTRYPOINT ["/bin/webhook-adapter"]
