FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/core-api-gateway ./cmd/core-api-gateway

FROM alpine:3.24
RUN adduser -D -u 10001 app
COPY --from=build /bin/core-api-gateway /bin/core-api-gateway
COPY migrations /app/migrations
USER app
EXPOSE 8080
ENTRYPOINT ["/bin/core-api-gateway"]
